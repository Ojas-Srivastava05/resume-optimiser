SMTP_EMAIL=srivastavaojas454@gmail.com
# NOT your normal Gmail password — create an App Password:
# Google Account → Security → 2-Step Verification → App passwords → Mail
SMTP_APP_PASSWORD=abcd efgh ijkl mnop

# Optional: Adzuna India API (https://developer.adzuna.com/)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Digest runs in IST; used for email subject line
DIGEST_HOUR=8

# Fast mode: parallel fetch (~11 min full GitHub Actions run)
FAST_MODE=1
COMPANY_BATCH_SIZE=120
FETCH_WORKERS=16
# Career portals scraped per run (100 = ~2 min; full 964 list in ~10 days)
CAREERS_MAX_SCRAPES=100
# CI guardrails — cap slow portal batches so digest email still sends
# CAREERS_TIME_BUDGET_SEC=240
# CAREERS_MAX_URLS_PER_COMPANY=1
# CAREERS_HTTP_TIMEOUT=8
# Infer real careers URLs when sheet has careers.google.com placeholders
# CAREERS_INFER_PLACEHOLDERS=1
# Oracle CX board discovery per run (cached in data/oracle_boards_cache.json)
# ORACLE_PROBE_PER_RUN=40

# Supabase — shared seen-jobs across GitHub Actions (logiflow project)
SUPABASE_URL=https://mwvohdvtxwltzkyuboaz.supabase.co
SUPABASE_KEY=your_supabase_anon_key

